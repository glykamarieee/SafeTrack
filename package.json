{
  "name": "safetrack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rnmapbox/maps": "^10.3.8",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-location": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-print": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.21",
    "expo-video": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "57.0.6",
    "patch-package": "^8.0.1",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "expo prebuild -p android && android\\gradlew.bat -p android app:assembleRelease -x lint -x test && expo run:android --variant release --binary android/app/build/outputs/apk/release/app-release.apk",
    "test": "jest",
    "test:auth": "jest __tests__/auth --verbose --forceExit"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/__tests__/setup/environment.js",
    "setupFiles": [
      "<rootDir>/__tests__/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup/mocks.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^expo-asset$": "<rootDir>/node_modules/expo/node_modules/expo-asset"
    },
    "testTimeout": 30000,
    "maxWorkers": 1
  },
  "private": true
}
